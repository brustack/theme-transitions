{
	"name": "theme-transitions",
	"private": true,
	"type": "module",
	"license": "MIT",
	"workspaces": [
		"packages/*",
		"apps/*"
	],
	"scripts": {
		"build": "npm run build --workspace=packages/core && npm run build --workspaces",
		"pretest": "npm run build --workspace=packages/core",
		"test": "vitest run",
		"lint": "eslint .",
		"pretypecheck": "npm run build --workspace=packages/core",
		"typecheck": "npm run typecheck --workspaces --if-present",
		"install:vue-demo": "npm install --workspace=apps/vue-demo --include-workspace-root",
		"predev:vue-demo": "npm run build --workspace=packages/core --workspace=packages/vue",
		"dev:vue-demo": "npm run dev --workspace=apps/vue-demo",
		"install:react-demo": "npm install --workspace=apps/react-demo --include-workspace-root",
		"predev:react-demo": "npm run build --workspace=packages/core --workspace=packages/react",
		"dev:react-demo": "npm run dev --workspace=apps/react-demo",
		"install:next-demo": "npm install --workspace=apps/next-demo --include-workspace-root",
		"predev:next-demo": "npm run build --workspace=packages/core --workspace=packages/next",
		"dev:next-demo": "npm run dev --workspace=apps/next-demo",
		"install:nuxt-demo": "npm install --workspace=apps/nuxt-demo --include-workspace-root",
		"predev:nuxt-demo": "npm run build --workspace=packages/core --workspace=packages/nuxt",
		"dev:nuxt-demo": "npm run dev --workspace=apps/nuxt-demo",
		"install:showcase": "npm install --workspace=apps/showcase --include-workspace-root",
		"predev:showcase": "npm run build --workspace=packages/core --workspace=packages/vue",
		"dev:showcase": "npm run dev --workspace=apps/showcase",
		"install:alpine-demo": "npm install --workspace=apps/alpine-demo --include-workspace-root",
		"predev:alpine-demo": "npm run build --workspace=packages/core --workspace=packages/alpine",
		"dev:alpine-demo": "npm run dev --workspace=apps/alpine-demo",
		"changeset": "changeset",
		"version-packages": "changeset version",
		"release": "npm run build && changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@stylistic/eslint-plugin": "^5.10.0",
		"eslint": "^10.8.0",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.65.0",
		"unbuild": "^3.6.0",
		"vitest": "^4.1.0"
	}
}
