{
	"name": "@brustack/theme-transitions-core",
	"version": "3.0.0",
	"description": "Framework-agnostic core for animated theme transitions using the View Transitions API",
	"author": "Bruno Neckel",
	"license": "MIT",
	"type": "module",
	"sideEffects": [
		"**/*.css"
	],
	"main": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"types": "./dist/index.d.mts",
			"import": "./dist/index.mjs"
		},
		"./vite": {
			"types": "./dist/vite-plugin.d.mts",
			"import": "./dist/vite-plugin.mjs"
		},
		"./style.css": "./style.css",
		"./theme-init.js": "./dist/theme-init.js"
	},
	"files": [
		"dist",
		"style.css"
	],
	"repository": {
		"type": "git",
		"url": "https://github.com/brustack/theme-transitions.git",
		"directory": "packages/core"
	},
	"publishConfig": {
		"access": "public"
	},
	"peerDependencies": {
		"vite": "^8.0.0"
	},
	"peerDependenciesMeta": {
		"vite": {
			"optional": true
		}
	},
	"devDependencies": {
		"vite": "^8.2.0"
	},
	"scripts": {
		"build": "unbuild && node scripts/build-css.mjs && node scripts/build-init.mjs",
		"prepublishOnly": "npm run build",
		"typecheck": "tsc --noEmit"
	},
	"keywords": [
		"theme",
		"theme-toggle",
		"theme-switcher",
		"dark-mode",
		"dark-theme",
		"framework-agnostic",
		"view-transitions",
		"view-transitions-api",
		"spread",
		"fade",
		"transition",
		"animation",
		"custom-themes",
		"vanilla-js"
	]
}
